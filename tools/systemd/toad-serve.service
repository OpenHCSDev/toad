[Unit]
Description=Toad browser workspace (loopback backend for tailnet-only Serve)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/ts
ExecStart=/home/ts/bin/toad serve --port 8040 --public-url https://desktop.tail553874.ts.net:8443 acp agent-comms-acp
UnsetEnvironment=PYTHONPATH NO_COLOR TOAD_VALIDATION
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=default.target
