        "scope": "TerminalTool",
        "kind": "FunctionDef",
        "source": "def present_execution(self, scrollback: set[int] | None, alternate: set[int] | None) -> None:\n    self.project_state(scrollback, alternate)\n    self.dispatch_sync(self.execution.outcome)"
