SettingsScreen {
    overflow: hidden;
    background: $background 60%;
    align-horizontal: right;

    &.-narrow SettingsPanel {
        width: 1fr;
    }

    SettingsPanel {
        width: 50%;
        padding: 0 1;
        background: black 10%;
    }

    SettingsSearch {
        dock: top;
        padding: 1 0;
    }

    Input, Select SelectCurrent, Checkbox, TextArea {
        border: tall black 20%;
        &:focus {
            border: tall $primary;
        }
    }

    Select:focus > SelectCurrent {
        border: tall $primary;
    }

    Input.-invalid {
        border: tall $error 60%;
    }
}
