#!/usr/bin/env bash
# Build or reuse the toad test environment: toad's locked dev group plus the
# agent-comms and Textual checkouts beside this one, installed editable, shared
# by input digest. Print the interpreter line to gate with. Never touches the
# live stack.
set -euo pipefail
umask 077
usage='Usage: toad-test-env [--uv PATH] [--python PATH] [--agent-comms DIR] [--textual DIR] [--cache DIR]'
toad_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
uv=uv
python=python3.14
agent_comms="$toad_root/../agent-comms"
textual="$toad_root/../textual"
cache="$HOME/.cache/toad/test-env"
while [[ $# -gt 0 ]]; do
    [[ $# -ge 2 ]] || { printf '%s\n' "$usage" >&2; exit 1; }
    case "$1" in
        --uv) uv=$2 ;;
        --python) python=$2 ;;
        --agent-comms) agent_comms=$2 ;;
        --textual) textual=$2 ;;
        --cache) cache=$2 ;;
        *) printf '%s\n' "$usage" >&2; exit 1 ;;
    esac
    shift 2
done
agent_comms=$(cd -- "$agent_comms" && pwd)
textual=$(cd -- "$textual" && pwd)
mkdir -p -- "$cache"
cache=$(cd -- "$cache" && pwd)
command -v -- "$uv" >/dev/null || {
    printf 'toad-test-env: %s is not on PATH; pass --uv PATH\n' "$uv" >&2
    exit 1
}
uv=$(command -v -- "$uv")
uv=$(readlink -f -- "$uv")
python=$("$uv" python find "$python")
interpreter_id=$("$python" -B "$toad_root/tools/test_environment_identity.py")
# Resolve the interpreter before even considering a cache hit; construction uses
# that same invocation. The recipe, native build and locked graph own this key.
build_id=$(cat "$toad_root/bin/toad-test-env" \
    "$toad_root/tools/test_environment_identity.py" "$toad_root/uv.lock" \
    "$toad_root/pyproject.toml" "$agent_comms/pyproject.toml" "$textual/pyproject.toml" "$uv" \
    <(printf '%s\n' "$toad_root" "$agent_comms" "$textual" "$uv" "$python" "$interpreter_id") |
    sha256sum | cut -c1-16)
environment="$cache/$build_id"

if [[ ! -e "$environment" ]]; then
    stage=$(mktemp -d "$environment.stage.XXXXXXXX")
    trap 'rm -rf -- "$stage"' EXIT
    "$uv" venv -q --relocatable --python "$python" "$stage"
    "$uv" export -q --project "$toad_root" --frozen --group dev --no-emit-project \
        --no-emit-package agent-comms --no-emit-package textual --no-hashes \
        -o "$stage/requirements.txt"
    # The export is the whole locked closure, so its own declared requirements are not
    # resolved again: textual-diff-view's textual@main would contest the checkout below.
    "$uv" pip install -q --python "$stage/bin/python" --no-deps -r "$stage/requirements.txt"
    # The sibling checkouts own agent-comms and textual; agent-comms' dev extra carries
    # the tools its tests need.
    "$uv" pip install -q --python "$stage/bin/python" -e "$textual[syntax]" -e "$agent_comms[dev]"
    # Toad reads its own distribution metadata; its source still comes from src.
    "$uv" pip install -q --python "$stage/bin/python" --no-deps "$toad_root"
    # Vim key modes run a real Neovim; its verified release lives under the
    # environment's own prefix, exactly as the installed runtime carries it.
    "$stage/bin/python" -c 'from toad.neovim_runtime import Neovim; Neovim().prepare()'
    mv -- "$stage" "$environment"
    trap - EXIT
fi
printf 'cd %s && %s -m pytest -n auto\n' "$toad_root" "$environment/bin/python"
